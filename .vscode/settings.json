{
  // 1. Otomatis compile saat file .tex disimpan
  "latex-workshop.latex.autoBuild.run": "onSave",

  // 2. Memindahkan file aux/log/sampah ke folder terpisah (.build)
  "latex-workshop.latex.outDir": "%DIR%/.build",

  // 3. Konfigurasi resep dan tool kompilasi
  "latex-workshop.latex.recipes": [
    {
      "name": "latexmk",
      "tools": [
        "latexmk"
      ]
    }
  ],
  
  "latex-workshop.latex.tools": [
    {
      "name": "latexmk",
      "command": "latexmk",
      "args": [
        "-synctex=1",
        "-interaction=nonstopmode",
        "-file-line-error",
        "-pdf",
        "-auxdir=%DIR%/.build",
        "-outdir=%DIR%",
        "-jobname=laporan-16026-295-380-060-055",
        "%DOC%"
      ],
      "env": {}
    }
  ]
}
