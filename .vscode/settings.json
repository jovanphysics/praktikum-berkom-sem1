{
  // 1. Otomatis compile saat file .tex disimpan
  "latex-workshop.latex.autoBuild.run": "onSave",

  // 2. Memindahkan file aux/log/sampah ke folder terpisah (.build)
  "latex-workshop.latex.outDir": "%DIR%/.build",

  // 3. Konfigurasi resep dan tool kompilasi
  "latex-workshop.latex.recipes": [
    {
      "name": "latexmk",
      "tools": [
        "latexmk"
      ]
    }
  ],
  "latex-workshop.latex.tools": [
    {
      "name": "latexmk",
      "command": "latexmk",
      "args": [
        "-synctex=1",
        "-interaction=nonstopmode",
        "-file-line-error",
        "-pdf",
        // Pindahkan file sampah ke folder .build
        "-auxdir=%DIR%/.build",
        // Setelah selesai, salin file PDF hasil compile kembali ke root folder proyek
        "-jobname=laporan.pdf",
        "-generated-exts=aux,idx,ind,lof,lot,out,toc,acn,acr,alg,glg,glo,gls,ist,fls,log,fdb_latexmk",
        "%DOC%"
      ],
      "env": {}
    }
  ]
}